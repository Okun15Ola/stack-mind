PAYSTACK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
ABANDON_AFTER_MINUTES=
# Diagnosis model. PROVIDER decides whether a model is used at all:
#   unset or "none" -> rules only, no model call; DIAGNOSIS_MODEL is ignored.
#   "groq"          -> Groq; needs GROQ_API_KEY. The documented default.
#   "anthropic"     -> Anthropic; needs ANTHROPIC_API_KEY.
# DIAGNOSIS_MODEL picks which model from that provider:
#   groq:      unset -> openai/gpt-oss-120b, checked against Groq's live model list.
#   anthropic: unset -> claude-haiku-5-5. Must be a claude-* id.
DIAGNOSIS_MODEL_PROVIDER=groq
DIAGNOSIS_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
