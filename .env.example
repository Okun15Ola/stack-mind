# Diagnosis model. PROVIDER decides whether a model is used at all:
#   unset or "none" -> rules only, no model call; DIAGNOSIS_MODEL is ignored.
#   "anthropic"     -> Anthropic; needs ANTHROPIC_API_KEY.
# DIAGNOSIS_MODEL picks which Anthropic model, only when PROVIDER=anthropic.
#   unset -> claude-haiku-5-5 (default). Must be a claude-* id.
DIAGNOSIS_MODEL_PROVIDER=
DIAGNOSIS_MODEL=
ANTHROPIC_API_KEY=
